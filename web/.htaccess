# ---------------------------------------------------------------------------
# Katia Oskina — public document root (web/).
#
# This file is the one Apache config that always applies to the live site,
# whether the hosting docroot points at the project root (and the root
# .htaccess rewrites into web/) or directly at web/. Static assets are served
# from this directory in both cases, so compression and caching belong here.
#
# Every block is wrapped in <IfModule> so a missing module degrades silently
# instead of throwing a 500. After deploying, verify with:
#   curl -sI -H "Accept-Encoding: gzip" https://katiaoskina.com/css/public.css
# and look for Content-Encoding + Cache-Control.
# ---------------------------------------------------------------------------

RewriteEngine on

# --- Canonical host: www.katiaoskina.com -> katiaoskina.com -----------------
# Both hostnames used to answer 200, which splits SEO signals between two
# addresses. http -> https is already handled by the hosting, so we only fix
# the host here (adding our own https redirect risks a loop behind a proxy).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --- Yii pretty URLs --------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php

# --- Compression ------------------------------------------------------------
# Nothing was compressed before this: jQuery went over the wire as 285 KB of
# raw text. Images (webp/jpg) are already compressed and are left alone.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json
    AddOutputFilterByType BROTLI_COMPRESS font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
    AddOutputFilterByType DEFLATE font/ttf font/otf
</IfModule>

# --- Caching ----------------------------------------------------------------
# Safe because content-addressed: image filenames are random and never reused,
# and css/js URLs carry ?v=<mtime> (assetManager.appendTimestamp in
# config/web.php). HTML itself must never be cached — it is rendered per user
# (the admin bar) and carries a per-request CSRF token.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                        "access plus 1 week"

    ExpiresByType text/html               "access plus 0 seconds"

    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"

    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"

    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType application/xml         "access plus 1 hour"
    ExpiresByType text/xml                "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # Long-lived immutable assets. HTML is excluded and handled below.
    # "unset" first: if the server or vhost config already sets a
    # Cache-Control (OSPanel locally sends max-age=0, must-revalidate), a bare
    # "set" here leaves both headers on the response and the two max-age
    # values contradict each other.
    <FilesMatch "\.(webp|jpe?g|png|gif|ico|svg|css|js|woff2?)$">
        Header unset Cache-Control
        Header always unset Cache-Control
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(xml|json|webmanifest)$">
        Header unset Cache-Control
        Header always unset Cache-Control
        Header always set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # --- Security headers ---------------------------------------------------
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS is only emitted over TLS; mod_ssl sets the HTTPS env var.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Nothing on this site needs these device APIs.
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
</IfModule>

# --- Correct types for files Apache may not know ---------------------------
<IfModule mod_mime.c>
    AddType image/webp                  .webp
    AddType application/manifest+json   .webmanifest
    AddType font/woff2                  .woff2
</IfModule>
