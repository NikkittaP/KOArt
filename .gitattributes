# The site is deployed by uploading this working copy to a Linux host
# (Hetzner) over SFTP - there is no build step and no SSH. Files where CRLF
# line endings could actually break server-side parsing are pinned to LF in
# the working tree, not just in the repository.
#
# Deliberately narrow: PHP/CSS/JS are fine with either ending on Linux, so
# they are left alone to avoid renormalising the whole tree.
.htaccess   text eol=lf
*.htaccess  text eol=lf
robots.txt  text eol=lf
*.webmanifest text eol=lf

# Binary assets must never be line-ending converted.
*.woff2 binary
*.woff  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
